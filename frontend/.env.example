# Backend API Base URL (Vercel deployment: use your deployed backend URL, e.g., https://grozo-backend.onrender.com)
VITE_BACKEND_URL=http://localhost:4000
# VITE_API_URL is also supported as an alias for VITE_BACKEND_URL
# VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional Map Tile Provider (Defaults to OpenStreetMap)
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAPBOX_TOKEN=
